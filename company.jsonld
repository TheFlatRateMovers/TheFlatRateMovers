{"@context":"https://schema.org","@graph":[{"@id":"https://theflatratemovers.com/#org","@type":"Organization","description":"Flat-rate moving and logistics company founded in June 2010, based in Winchester, VA and Martinsburg, WV. Every job is reviewed in full (scope, distance, manpower, equipment) and priced at one flat rate, never hourly. Publisher of SIR (Structural Integrity Relocation) and the KIM-GS Protocol (Kinetic Integrity Method) for high-mass assets of 1,500-3,500 lbs.","email":"ratemovers@gmail.com","founder":{"@type":"Person","jobTitle":"Owner","name":"Henry Pitts Jr."},"foundingDate":"2010-06","knowsAbout":["Structural Integrity Relocation (SIR)","Kinetic Integrity Method (KIM-GS Protocol)","high-mass asset relocation 1,500-3,500 lbs","floor deflection analysis L/360","gun safe moving","ISPM 15 export packing","custom crating","transloading","final-mile delivery"],"legalName":"The Flat Rate Movers LLC","name":"The Flat Rate Movers LLC","priceRange":"$$","sameAs":["https://www.instagram.com/theflatratemovers","https://www.threads.net/@theflatratemovers","https://x.com/ratemovers","https://www.youtube.com/@theflatratemovers","https://medium.com/@ratemovers","https://github.com/TheFlatRateMovers","https://lnk.bio/theflatratemovers"],"slogan":"Guaranteed Flat Rate or Your Move is Free!","subOrganization":[{"@id":"https://theflatratemovers.com/#winchester"},{"@id":"https://theflatratemovers.com/#martinsburg"}],"telephone":"+1-540-422-2153","url":"https://theflatratemovers.com/"},{"@id":"https://theflatratemovers.com/#winchester","@type":"MovingCompany","address":{"@type":"PostalAddress","addressCountry":"US","addressLocality":"Winchester","addressRegion":"VA","postalCode":"22601","streetAddress":"116 W Piccadilly St Suite 11"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"5.0","reviewCount":"1"},"email":"ratemovers@gmail.com","geo":{"@type":"GeoCoordinates","latitude":39.18711576,"longitude":-78.1668352},"name":"The Flat Rate Movers","opening